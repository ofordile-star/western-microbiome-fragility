def lcc(Am,keepmask):
    sub=Am[np.ix_(keepmask,keepmask)]
    if sub.shape[0]==0: return 0
    nc,lab=connected_components(sparse.csr_matrix(sub),directed=False); return np.bincount(lab).max()/Am.shape[0]*0+np.bincount(lab).max()
def robust(Am,present,order_score,steps=10):
    # targeted attack among present nodes by score; return mean LCC fraction (of present count) across removal fractions
    idx=np.where(present)[0]
    if len(idx)<10: return np.nan
    ordr=idx[np.argsort(-order_score[idx])]; vals=[]
    for f in np.linspace(0,0.5,steps+1):
        k=int(round(f*len(idx))); m=present.copy(); m[ordr[:k]]=False
        vals.append(lcc(Am,m)/len(idx))
    return float(np.mean(vals))
def child_feats(Am,mid,Pres,degv):
    out=[]; hub=degv>=np.quantile(degv,0.9)
    for r in Pres:
        idx=np.where(r)[0]; sub=Am[np.ix_(idx,idx)]; n=len(idx)
        dens=sub.sum()/(n*(n-1)); md=sub.sum(1).mean()
        cnt=np.bincount(mid[idx],minlength=mid.max()+1); q=cnt/cnt.sum(); ev=np.exp(-(q[q>0]*np.log(q[q>0])).sum())
        out.append((dens,md,hub[idx].mean(),ev,robust(Am,r,degv)))
    return pd.DataFrame(out,columns=['net_density','net_meandeg','net_hubfrac','net_modeven','net_robust'],index=d.index)
