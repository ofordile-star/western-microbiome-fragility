def fit(Cm,alpha):
    Z=(Cm-Cm.mean(0))/Cm.std(0); S=np.corrcoef(Z.T)
    _,P=graphical_lasso(S,alpha=alpha,max_iter=300,tol=1e-3)
    A=(np.abs(P)>1e-6).astype(int); np.fill_diagonal(A,0)
    pc=-P/np.sqrt(np.outer(np.diag(P),np.diag(P))); np.fill_diagonal(pc,0); pc=pc*A
    return A,pc,S,P
def ebic(S,P,n,gam=0.5):
    p=S.shape[0]; ll=n/2*(np.linalg.slogdet(P)[1]-np.trace(S@P)); E=((np.abs(P)>1e-6).sum()-p)//2
    return -2*ll+E*np.log(n)+4*gam*E*np.log(p)
