def box(x,y,w,h,t,fc,ec='#333',fs=6.6,min_fs=5.0):
    ax.add_patch(FancyBboxPatch((x,y),w,h,boxstyle='round,pad=0.03,rounding_size=0.12',fc=fc,ec=ec,lw=0.9))
    tx=ax.text(x+w/2,y+h/2,t,ha='center',va='center',fontsize=fs,linespacing=1.15)
    inv=ax.transData.inverted()
    while fs>min_fs:                                  # shrink the text until it sits inside the box with a margin
        bb=tx.get_window_extent(_rend).transformed(inv)
        if bb.width<=w*0.90 and bb.height<=h*0.86: break
        fs-=0.2; tx.set_fontsize(fs)
    bb=tx.get_window_extent(_rend).transformed(inv); assert bb.width<=w*0.94 and bb.height<=h*0.90, f'text does not fit its box: {t!r}'
