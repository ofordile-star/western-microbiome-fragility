def run(name,sd,y,extra=None,nullrun=True,reps=30):
    cv=sd['cv'].copy()
    if extra is not None: cv=pd.concat([cv,extra],axis=1)
    base=cv.values.astype(float); base=(base-base.mean(0))/np.where(base.std(0)>0,base.std(0),1); dv=sd['div'].copy(); dv=(dv-dv.mean())/dv.std(); nf=sd['NF']; P=pcs(sd['C'])
    sets={'base':base,'base+richness':np.c_[base,dv.q0],'base+Hill q0-2':np.c_[base,dv.values],'network only (+base)':np.c_[base,nf.values],
          'base+richness+network':np.c_[base,dv.q0,nf.values],'base+richness+10 CLR PCs':np.c_[base,dv.q0,P]}
    res={}; 
    for k,F in sets.items(): res[k]=oof_auc(F,y,reps)
    ref=res['base+richness']
    for k,(a,pm) in res.items():
        dm=boot_diff(y,ref[1],pm) if k!='base+richness' else (0,0,0)
        rows.append(dict(analysis=name,model=k,n=len(y),events=int(y.sum()),auc=a.mean(),auc_sd_splits=a.std(),d_vs_richness=dm[0],d_lo=dm[1],d_hi=dm[2]))
    # null networks
    if nullrun:
        gain=[]
        for An in nulls[:20]:
            Fn=child_feats(An,modid,sd['Pr'],sd['m'].index)
            a,_=oof_auc(np.c_[base,dv.q0,Fn.values],y,reps=8); gain.append(a.mean())
        obs=res['base+richness+network'][0][:8].mean()
        rows.append(dict(analysis=name,model='NULL degree-preserving networks (mean of 20)',n=len(y),events=int(y.sum()),auc=np.mean(gain),auc_sd_splits=np.std(gain),d_vs_richness=np.nan,d_lo=np.nan,d_hi=np.nan))
        rows.append(dict(analysis=name,model='empirical p (obs >= null)',n=len(y),events=int(y.sum()),auc=(1+sum(g>=obs for g in gain))/(1+len(gain)),auc_sd_splits=np.nan,d_vs_richness=np.nan,d_lo=np.nan,d_hi=np.nan))
    # LR tests: feature added to richness model
    Xb=sm.add_constant(np.c_[base,dv.q0]); m0=sm.Logit(y,Xb).fit(disp=0,method='newton',maxiter=100)
    lr=[]
    for c in nf.columns:
        z=(nf[c]-nf[c].mean())/nf[c].std(); m1=sm.Logit(y,np.c_[Xb,z]).fit(disp=0,method='newton',maxiter=100)
        lr.append(dict(analysis=name,feature=c,OR_per_SD=np.exp(m1.params[-1]),lo=np.exp(m1.conf_int()[-1,0]),hi=np.exp(m1.conf_int()[-1,1]),p=m1.pvalues[-1],LRp=1-__import__('scipy.stats').stats.chi2.cdf(2*(m1.llf-m0.llf),1)))
    L=pd.DataFrame(lr); L['q_BH']=multipletests(L.p,method='fdr_bh')[1]; return L
