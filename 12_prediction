def make_set(tp):
    m=mb[(mb.timepoints==tp)&mb.Ill_binary.notna()].copy(); Xm=m[sp].values.astype(float)
    cv=pd.DataFrame({'age':m.age_enrolment,'sex':m.gender_n,'iron':(m.iron_arm=='treatment').astype(int),'dry':(m.season=='dry').astype(int),'depth':np.log(Xm.sum(1))},index=m.index)
    cv['haz']=m.HAZ_enrolment.fillna(m.HAZ_enrolment.median())
    cv=pd.concat([cv,pd.get_dummies(m.location,prefix='loc',drop_first=True).astype(int)],axis=1)
    Pr=Xm[:,keep]>0; Cm=np.log(Xm+0.5); Cm=(Cm-Cm.mean(1,keepdims=True))[:,keep]
    p=Xm/Xm.sum(1,keepdims=True); H=-np.where(p>0,p*np.log(np.where(p>0,p,1)),0).sum(1)
    div=pd.DataFrame({'q0':(Xm>0).sum(1),'q1':np.exp(H),'q2':1/(p**2).sum(1)},index=m.index)
    NF=child_feats(A,modid,Pr,m.index)
    return dict(m=m,cv=cv,div=div,NF=NF,Pr=Pr,C=Cm,y=m.Ill_binary.astype(int).values)
