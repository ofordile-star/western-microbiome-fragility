# ---------- CV ----------
def oof_auc(F,y,reps=30,C=0.3):
    F=np.asarray(F,float); pr=np.zeros((reps,len(y))); aucs=[]
    for r in range(reps):
        for tr,te in StratifiedKFold(5,shuffle=True,random_state=r).split(F,y):
            mdl=make_pipeline(StandardScaler(),LogisticRegression(C=C,max_iter=3000)).fit(F[tr],y[tr]); pr[r,te]=mdl.decision_function(F[te])
        aucs.append(roc_auc_score(y,pr[r]))
    return np.array(aucs),pr.mean(0)
def boot_diff(y,pa,pb,B=1000,seed=3):
    g=np.random.default_rng(seed); n=len(y); out=[]
    for _ in range(B):
        i=g.integers(0,n,n)
        if y[i].min()==y[i].max(): continue
        out.append(roc_auc_score(y[i],pb[i])-roc_auc_score(y[i],pa[i]))
    return np.mean(out),np.percentile(out,2.5),np.percentile(out,97.5)
def pcs(Cm,k=10): return PCA(k,random_state=0).fit_transform(Cm)
