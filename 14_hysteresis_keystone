 'coef_unadj_richness':[h1.params['burden'],h1.params['since_c']],'p_unadj_richness':[h1.pvalues['burden'],h1.pvalues['since_c']],
 'coef_adj_richness':[h2.params['burden'],h2.params['since_c']],'p_adj_richness':[h2.pvalues['burden'],h2.pvalues['since_c']]})
