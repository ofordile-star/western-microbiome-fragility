m=smf.ols('lps ~ pre_n + age_enrolment + gender_n + haz + Cat(iron_arm) + Cat(season) + Cat(location)',dd).fit(); R['lps_burden_noRich']=dict(coef=m.params['pre_n'],p=m.pvalues['pre_n']); print(R['lps_burden'],R['lps_burden_noRich'])
# ===== 5. keystone analysis
G=nx.from_numpy_array(A); p=len(spk); degv=A.sum(1); bt=nx.betweenness_centrality(G); 
def knock(i):
    H0=G.copy(); H0.remove_node(i); l=max((len(c) for c in nx.connected_components(H0)),default=0); return len(max(nx.connected_components(G),key=len))-l, nx.number_connected_components(H0)
nodes=pd.DataFrame({'species':spk,'degree':degv,'betweenness':[bt[i] for i in range(p)],'prevalence':keep.sum() and (X[:,keep]>0).mean(0),'mean_rel_ab':(X[:,keep]/X.sum(1,keepdims=True)).mean(0),'module':modid})
nodes['lcc_loss_on_removal']=[knock(i)[0] for i in range(p)]
nodes['deg_pct']=nodes.degree.rank(pct=True); nodes['btw_pct']=nodes.betweenness.rank(pct=True); nodes['knock_pct']=nodes.lcc_loss_on_removal.rank(pct=True)
nodes['is_Ps']=nodes.species=='Prevotella_stercorea_7.05'; nodes.sort_values('degree',ascending=False).to_csv('out/node_table.csv',index=False)
ps=nodes[nodes.is_Ps].iloc[0]; print(ps.to_dict())
# abundance/prevalence-matched comparison
m_=nodes[(~nodes.is_Ps)&(nodes.prevalence.between(ps.prevalence-0.1,ps.prevalence+0.1))]; print('matched nodes',len(m_),'median deg',m_.degree.median(),'Ps deg',ps.degree)
nb=[(spk[j],pcm[psi,j]) for j in np.where(A[psi])[0]]; nb.sort(key=lambda t:-abs(t[1])); print('Ps neighbours',nb)
# bootstrap stability
bd=[];edge=np.zeros(p);rk=[]
NBOOT=60
for _ in range(NBOOT):
    ix=rng.integers(0,len(C),len(C)); Ab,_=fit(C[ix],alpha); bd.append(Ab[psi].sum()); edge+=Ab[psi]; rk.append((Ab.sum(1)<Ab[psi].sum()).mean())
R['Ps_boot']=dict(deg_mean=float(np.mean(bd)),deg_ci=[float(np.percentile(bd,2.5)),float(np.percentile(bd,97.5))],deg_pct_mean=float(np.mean(rk)),edge_freq={spk[j]:float(edge[j]/NBOOT) for j in np.argsort(-edge)[:6]})
print(R['Ps_boot'])
# empirical: neighborhood score of Ps (mean CLR of its network neighbours) vs infection, adjusting richness
nbi=np.where(A[psi])[0]; dd['ps_clr']=C[:,psi]; dd['nb_clr']=C[:,nbi].mean(1) if len(nbi) else 0
for v in ('ps_clr','nb_clr'): dd[v+'_z']=(dd[v]-dd[v].mean())/dd[v].std()
rows=[]
for out in ('ever_ill','post_any'):
    ex=' + pre_n + recent14' if out=='post_any' else ''
    for form in (f'{out} ~ ps_clr_z + z_rich + dz + age_enrolment + gender_n + haz + Cat(iron_arm) + Cat(season) + Cat(location){ex}',f'{out} ~ ps_clr_z + nb_clr_z + z_rich + dz + age_enrolment + gender_n + haz + Cat(iron_arm) + Cat(season) + Cat(location){ex}'):
        m=smf.logit(form,dd).fit(disp=0)
        for t in [x for x in ('ps_clr_z','nb_clr_z') if x in m.params.index]:
            rows.append(dict(outcome=out,term=t,model='Ps + neighbours' if 'nb_clr_z' in form else 'Ps only',OR_per_SD=np.exp(m.params[t]),lo=np.exp(m.conf_int().loc[t,0]),hi=np.exp(m.conf_int().loc[t,1]),p=m.pvalues[t]))
K=pd.DataFrame(rows); K.to_csv('out/keystone_models.csv',index=False); print(K.round(3).to_string())
