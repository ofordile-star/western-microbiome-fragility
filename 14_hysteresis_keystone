# distance by recency class, never vs ill with PERMANOVA-like test (Euclidean on CLR = Aitchison)
def pseudoF(M,g):
    ug=np.unique(g); gm=M.mean(0); ssb=sum((g==u).sum()*((M[g==u].mean(0)-gm)**2).sum() for u in ug); ssw=sum(((M[g==u]-M[g==u].mean(0))**2).sum() for u in ug)
    return (ssb/(len(ug)-1))/(ssw/(len(M)-len(ug)))
g=(d.grp!='never').values.astype(int); F0=pseudoF(C,g)
perm=[pseudoF(C,rng.permutation(g)) for _ in range(499)]; p_raw=(1+sum(x>=F0 for x in perm))/500
# residualize on richness+covariates (not on group) then test
Dm=np.c_[np.ones(len(d)),dd[['z_rich','dz','age_enrolment','gender_n','haz']].values.astype(float),pd.get_dummies(dd.location,drop_first=True).values.astype(float),(dd.season=='dry').values.astype(float),(dd.iron_arm=='treatment').values.astype(float)]
res=C-Dm@np.linalg.lstsq(Dm,C,rcond=None)[0]; F1=pseudoF(res,g); perm1=[pseudoF(res,rng.permutation(g)) for _ in range(499)]; p_res=(1+sum(x>=F1 for x in perm1))/500
R['permanova']=dict(F_raw=F0,p_raw=p_raw,F_resid=F1,p_resid=p_res); print(R['permanova'])
