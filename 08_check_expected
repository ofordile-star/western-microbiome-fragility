# 08_check_expected.py -- compares key numbers regenerated by this package with the values reported in the manuscript.
# Exit status 0 = all checks pass. Tolerances allow for rounding in the manuscript.
import os, sys, re
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import config
import pandas as pd, numpy as np
R = lambda f: pd.read_csv(os.path.join(config.RESULTS, f))
W = lambda f: pd.read_csv(os.path.join(config.WORK, f))
checks = []
def add(name, value, expected, tol): checks.append((name, float(value), expected, tol))
cl = W('child_level.csv')
add('Children, never ill', (cl.grp == 'never').sum(), 137, 0)
add('Children, infection on or before day 85', (cl.grp == 'ill by D85').sum(), 295, 0)
add('Children, first infection after day 85', (cl.grp == 'first ill after D85').sum(), 20, 0)
h = R('hill_effects.csv'); w = h[(h.contrast.str.startswith('whole')) & (h.measure == 'q0')].iloc[0]; st = h[(h.contrast.str.startswith('strict')) & (h.measure == 'q0')].iloc[0]
add('Mean richness, never ill', w.mean_never, 103.06, 0.05); add('Mean richness, ill', w.mean_ill, 93.90, 0.05)
add("Cohen's d richness, never vs ill", w.d, 0.36, 0.01); add("Cohen's d richness, never vs first ill after D85", st.d, 0.48, 0.01)
rb = R('richness_robustness_or.csv').set_index('model')
add('OR per species, unadjusted', rb.loc['Unadjusted', 'OR'], 0.986, 0.001); add('OR per species, adjusted', rb.loc['Adjusted', 'OR'], 0.989, 0.001); add('p, adjusted OR', rb.loc['Adjusted', 'p'], 0.019, 0.003)
add('p, rarefied OR', rb.loc['Adjusted, rarefied to 10,000 counts', 'p'], 0.043, 0.005); add('p, prevalence-filtered OR', rb.loc['Adjusted, species in <5% of samples removed', 'p'], 0.024, 0.004)
tp = R('timepoint_richness_tests.csv').set_index('timepoint')
add('Adjusted richness difference at D85', tp.loc['D85', 'diff_never_minus_ill'], 5.9, 0.1); add('Adjusted p at D85', tp.loc['D85', 'p'], 0.013, 0.003)
add('Adjusted p at D1', tp.loc['D1', 'p'], 0.13, 0.01); add('Adjusted p at D15', tp.loc['D15', 'p'], 0.19, 0.01)
rc = R('redundancy_correlations.csv').set_index('order')
for q, e in ((0, 0.93), (1, 0.63), (2, 0.33)): add(f'Spearman rho richness vs redundancy, q = {q}', rc.loc[q, 'spearman_rho_richness_vs_redundancy'], e, 0.01)
fw = R('forward_results.csv').set_index(['outcome', 'exposure'])
for (o, x), e in {('AE Infection', 'q0'): 0.69, ('AE Infection', 'q1'): 0.68, ('AE Infection', 'q2'): 0.72, ('AE Fever', 'q0'): 0.70, ('AE Infection', 'red1 | richness'): 0.78, ('AE Infection', 'red2 | richness'): 0.81}.items():
    add(f'Post-sampling rate ratio {o} {x}', fw.loc[(o, x), 'RR_per_SD'], e, 0.011)
mm = R('FR_model_results.csv'); mm['model'] = mm['model'].astype(str)
add('Whole-follow-up redundancy RR, ARI, q = 2 (M2)', mm[(mm.outcome == 'ARI') & (mm.model == 'M2_q2')].estimate.iloc[0], 0.48, 0.01)
sel = mm[mm.model.str.match(r'^M[23]_q[12]$')]; add('Smallest corrected q, redundancy models q = 1-2', sel.q_bh.min(), 0.141, 0.002)
rt = R('rare_taxon.csv').set_index('var')
for v, e in (('rich_common', 0.31), ('rich_intermediate', 0.37), ('rich_rare', 0.07)): add(f"Cohen's d, {v}", rt.loc[v, 'd'], e, 0.01)
rec = R('recovery.csv')
for i, e in enumerate((88.7, 89.0, 96.8, 94.6)): add(f'Richness by time since last episode, class {i + 1}', rec.richness.iloc[i], e, 0.1)
Z = pd.read_csv(os.path.join(config.DERIVED, 'species_similarity.csv'), index_col=0); g = np.array([re.split('_', c)[0] for c in Z.index]); iu = np.triu_indices(len(Z), 1); same = (g[:, None] == g[None, :])[iu]; v = Z.values[iu]
add('Mean similarity, same genus', v[same].mean(), 0.80, 0.01); add('Mean similarity, different genus', v[~same].mean(), 0.38, 0.01)
mp = pd.read_csv(os.path.join(config.DERIVED, 'species_similarity_mapping.csv')).level.value_counts()
add('Species matched at species level', mp.get('species', 0), 259, 0); add('Species matched at genus level', mp.get('genus', 0), 220, 0); add('Species unmapped', mp.get('none', 0), 9, 0)
import os as _os
if _os.path.exists(_os.path.join(config.RESULTS, 'asv_replication.csv')):
    av = R('asv_replication.csv'); a5 = av[av.rarefied_to == 5000].iloc[0]
    add('ASV replication: Cohen d, never vs ill (5,000 reads)', a5.cohen_d_never_minus_ill, 0.39, 0.01)
    add('ASV replication: adjusted OR per SD', a5.OR_infection_per_SD, 0.75, 0.01); add('ASV replication: post-sampling rate ratio per SD', a5.RR_post_sampling_per_SD, 0.69, 0.01)
    add('ASV vs species richness, Spearman', R('asv_vs_species_richness.csv').spearman_asv_vs_species_richness.iloc[0], 0.90, 0.01)
rows = []; bad = 0
for n, val, e, tol in checks:
    ok = abs(val - e) <= tol + 1e-9; bad += (not ok); rows.append((('PASS' if ok else 'FAIL'), n, round(val, 4), e, tol))
out = pd.DataFrame(rows, columns=['status', 'check', 'computed', 'reported', 'tolerance']); out.to_csv(os.path.join(config.RESULTS, 'check_expected_values.csv'), index=False)
print(out.to_string(index=False)); print(f'\n{len(out) - bad} of {len(out)} checks passed'); sys.exit(1 if bad else 0)
